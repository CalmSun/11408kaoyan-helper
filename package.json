{
  "name": "kaoyan-helper",
  "version": "3.5.2",
  "description": "考研助手桌面应用 - 你的专属备考伙伴",
  "main": "dist/main/main.js",
  "author": "Kaoyan Helper",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.node.json && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@open-file-viewer/core": "^0.1.40",
    "dayjs": "^1.11.10",
    "echarts": "^5.4.3",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.5.0",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-demi": "^0.14.10",
    "vue-echarts": "^6.6.8",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^3.3.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.kaoyan.helper",
    "productName": "11408考研助手",
    "directories": {
      "output": "release-v352"
    },
    "extraResources": [
      {
        "from": "resources/tray-icon.png",
        "to": "tray-icon.png"
      }
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/renderer/src/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/renderer/src/assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/renderer/src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "考研助手"
    }
  },
  "publish": {
    "provider": "github",
    "owner": "CalmSun",
    "repo": "11408kaoyan-helper",
    "releaseType": "release"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true,
    "vue-demi@0.13.11": true,
    "vue-echarts@6.7.3": true
  }
}
